---
 drivers/iommu/iommufd/pages.c           |   8 ++
 include/linux/mm.h                      |   2 +
 mm/gup.c                                |  57 ++++++++++++
 tools/testing/selftests/iommu/iommufd.c | 117 ++++++++++++++++++++++++
 4 files changed, 184 insertions(+)

diff --git a/drivers/iommu/iommufd/pages.c b/drivers/iommu/iommufd/pages.c
index 2f6153108add7..c1f02c3150fb0 100644
--- a/drivers/iommu/iommufd/pages.c
+++ b/drivers/iommu/iommufd/pages.c
@@ -1426,10 +1426,17 @@ struct iopt_pages *iopt_alloc_file_pages(struct file *file,
 
 {
 	struct iopt_pages *pages;
+	int rc;
 
 	pages = iopt_alloc_pages(start_byte, length, writable);
 	if (IS_ERR(pages))
 		return pages;
+	/* Pins may be deferred until a domain or access is attached. */
+	rc = memfd_pin_folios_begin(file, writable);
+	if (rc) {
+		iopt_put_pages(pages);
+		return ERR_PTR(rc);
+	}
 	pages->file = get_file(file);
 	pages->start = start - start_byte;
 	pages->type = IOPT_ADDRESS_FILE;
@@ -1671,6 +1678,7 @@ void iopt_release_pages(struct kref *kref)
 		dma_buf_put(dmabuf);
 		WARN_ON(!list_empty(&pages->dmabuf.tracker));
 	} else if (pages->type == IOPT_ADDRESS_FILE) {
+		memfd_pin_folios_end(pages->file, pages->writable);
 		fput(pages->file);
 	}
 	mmdrop(pages->source_mm);
diff --git a/include/linux/mm.h b/include/linux/mm.h
index d89e6f823c9f3..a060a71504015 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -3515,6 +3515,8 @@ long get_user_pages_unlocked(unsigned long start, unsigned long nr_pages,
 		    struct page **pages, unsigned int gup_flags);
 long pin_user_pages_unlocked(unsigned long start, unsigned long nr_pages,
 		    struct page **pages, unsigned int gup_flags);
+int memfd_pin_folios_begin(struct file *file, bool writable);
+void memfd_pin_folios_end(struct file *file, bool writable);
 long memfd_pin_folios(struct file *memfd, loff_t start, loff_t end,
 		      struct folio **folios, unsigned int max_folios,
 		      pgoff_t *offset);
diff --git a/mm/gup.c b/mm/gup.c
index 335dcb3a5c17a..21d40d33bf194 100644
--- a/mm/gup.c
+++ b/mm/gup.c
@@ -3432,6 +3432,63 @@ long pin_user_pages_unlocked(unsigned long start, unsigned long nr_pages,
 }
 EXPORT_SYMBOL(pin_user_pages_unlocked);
 
+/**
+ * memfd_pin_folios_begin - authorize a lifetime of direct memfd pinning
+ * @file: file whose folios will be pinned
+ * @writable: whether the pinned folios may be written
+ *
+ * Check file access and seals before establishing a source of direct pins.
+ * A writable source prevents F_SEAL_WRITE until memfd_pin_folios_end(),
+ * including intervals when it has no pins. F_SEAL_FUTURE_WRITE prevents
+ * new writable sources but leaves existing ones usable.
+ *
+ * The caller must retain a reference to @file until the matching end call.
+ * Each successful begin must have exactly one end with the same @writable.
+ *
+ * Context: May sleep. Do not hold the inode lock.
+ * Return: 0 on success, or a negative error code.
+ */
+int memfd_pin_folios_begin(struct file *file, bool writable)
+{
+	int seals, ret = 0;
+
+	if (!shmem_file(file) && !is_file_hugepages(file))
+		return -EINVAL;
+
+	if (!(file->f_mode & FMODE_READ) ||
+	    (writable && !(file->f_mode & FMODE_WRITE)))
+		return -EACCES;
+
+	inode_lock_shared(file_inode(file));
+	seals = IS_ENABLED(CONFIG_MEMFD_CREATE) ? memfd_get_seals(file) : 0;
+	if (seals < 0) {
+		ret = seals;
+	} else if (writable) {
+		if (seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE))
+			ret = -EPERM;
+		else
+			ret = mapping_map_writable(file->f_mapping);
+	}
+	inode_unlock_shared(file_inode(file));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(memfd_pin_folios_begin);
+
+/**
+ * memfd_pin_folios_end - release an authorization for direct memfd pinning
+ * @file: file passed to memfd_pin_folios_begin()
+ * @writable: value passed to memfd_pin_folios_begin()
+ *
+ * All pins from this authorization must have been released, and no further
+ * pins may be acquired using it. The caller still owns its file reference.
+ */
+void memfd_pin_folios_end(struct file *file, bool writable)
+{
+	if (writable)
+		mapping_unmap_writable(file->f_mapping);
+}
+EXPORT_SYMBOL_GPL(memfd_pin_folios_end);
+
 /**
  * memfd_pin_folios() - pin folios associated with a memfd
  * @memfd:      the memfd whose folios are to be pinned
diff --git a/tools/testing/selftests/iommu/iommufd.c b/tools/testing/selftests/iommu/iommufd.c
index ca2b35e9d443a..d59737c54d8e2 100644
--- a/tools/testing/selftests/iommu/iommufd.c
+++ b/tools/testing/selftests/iommu/iommufd.c
@@ -1627,6 +1627,123 @@ TEST_F(iommufd_ioas, dmabuf_revoke)
 	close(dfd);
 }
 
+/* These also run without a domain, before MAP_FILE pins any pages. */
+TEST_F(iommufd_ioas, map_file_seals)
+{
+	static const unsigned int seals[] = {
+		F_SEAL_WRITE,
+		F_SEAL_FUTURE_WRITE,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(seals); i++) {
+		__u64 iova;
+		int fd;
+
+		fd = memfd_create("sealed", MFD_ALLOW_SEALING);
+		ASSERT_NE(-1, fd);
+		ASSERT_EQ(0, ftruncate(fd, PAGE_SIZE));
+		ASSERT_EQ(0, fcntl(fd, F_ADD_SEALS, seals[i]));
+
+		test_err_ioctl_ioas_map_file(EPERM, fd, 0, PAGE_SIZE, &iova);
+		/* Write seals do not prohibit device reads. */
+		ASSERT_EQ(0, _test_ioctl_ioas_map_file(
+			self->fd, self->ioas_id, fd, 0, PAGE_SIZE, &iova,
+			IOMMU_IOAS_MAP_READABLE));
+		test_ioctl_ioas_unmap(iova, PAGE_SIZE);
+		ASSERT_EQ(0, close(fd));
+	}
+}
+
+TEST_F(iommufd_ioas, map_file_fd_access)
+{
+	char path[64];
+	__u64 iova;
+	int fd, read_fd, write_fd;
+
+	fd = memfd_create("sealed", MFD_ALLOW_SEALING);
+	ASSERT_NE(-1, fd);
+	ASSERT_EQ(0, ftruncate(fd, PAGE_SIZE));
+	snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+	read_fd = open(path, O_RDONLY);
+	ASSERT_NE(-1, read_fd);
+	write_fd = open(path, O_WRONLY);
+	ASSERT_NE(-1, write_fd);
+
+	test_err_ioctl_ioas_map_file(EACCES, read_fd, 0, PAGE_SIZE, &iova);
+	ASSERT_EQ(0, _test_ioctl_ioas_map_file(
+		self->fd, self->ioas_id, read_fd, 0, PAGE_SIZE, &iova,
+		IOMMU_IOAS_MAP_READABLE));
+	test_ioctl_ioas_unmap(iova, PAGE_SIZE);
+
+	/* Like mmap(), all direct file mappings require read access. */
+	test_err_ioctl_ioas_map_file(EACCES, write_fd, 0, PAGE_SIZE, &iova);
+	EXPECT_ERRNO(EACCES, _test_ioctl_ioas_map_file(
+		self->fd, self->ioas_id, write_fd, 0, PAGE_SIZE, &iova,
+		IOMMU_IOAS_MAP_READABLE));
+	ASSERT_EQ(0, close(write_fd));
+	ASSERT_EQ(0, close(read_fd));
+	ASSERT_EQ(0, close(fd));
+}
+
+TEST_F(iommufd_ioas, map_file_seal_lifetime)
+{
+	struct iommu_ioas_copy copy_cmd = {
+		.size = sizeof(copy_cmd),
+		.flags = IOMMU_IOAS_MAP_READABLE | IOMMU_IOAS_MAP_WRITEABLE,
+		.src_ioas_id = self->ioas_id,
+		.length = PAGE_SIZE,
+	};
+	__u64 iova;
+	int fd;
+
+	fd = memfd_create("sealed", MFD_ALLOW_SEALING);
+	ASSERT_NE(-1, fd);
+	ASSERT_EQ(0, ftruncate(fd, PAGE_SIZE));
+	test_ioctl_ioas_map_file(fd, 0, PAGE_SIZE, &iova);
+	EXPECT_ERRNO(EBUSY, fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE));
+
+	/* A failed map must undo its writable-mapping reference. */
+	EXPECT_ERRNO(EEXIST, _test_ioctl_ioas_map_file(
+		self->fd, self->ioas_id, fd, 0, PAGE_SIZE, &iova,
+		IOMMU_IOAS_MAP_FIXED_IOVA | IOMMU_IOAS_MAP_READABLE |
+		IOMMU_IOAS_MAP_WRITEABLE));
+
+	test_ioctl_ioas_alloc(&copy_cmd.dst_ioas_id);
+	copy_cmd.src_iova = iova;
+	ASSERT_EQ(0, ioctl(self->fd, IOMMU_IOAS_COPY, &copy_cmd));
+	test_ioctl_ioas_unmap(iova, PAGE_SIZE);
+	/* The copied mapping has no domain, but still permits later writes. */
+	EXPECT_ERRNO(EBUSY, fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE));
+
+	test_ioctl_destroy(copy_cmd.dst_ioas_id);
+	ASSERT_EQ(0, fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE));
+	ASSERT_EQ(0, close(fd));
+}
+
+TEST_F(iommufd_ioas, map_file_future_write)
+{
+	__u64 iova, new_iova;
+	int fd;
+
+	fd = memfd_create("sealed", MFD_ALLOW_SEALING);
+	ASSERT_NE(-1, fd);
+	ASSERT_EQ(0, ftruncate(fd, PAGE_SIZE));
+	iova = MOCK_APERTURE_START;
+	test_ioctl_ioas_map_fixed_file(fd, 0, PAGE_SIZE, iova);
+	ASSERT_EQ(0, fcntl(fd, F_ADD_SEALS, F_SEAL_FUTURE_WRITE));
+
+	/* A preexisting mapping can still acquire its deferred pins. */
+	if (!variant->mock_domains)
+		test_cmd_mock_domain(self->ioas_id, &self->stdev_id,
+				     &self->hwpt_id, &self->device_id);
+	test_err_ioctl_ioas_map_file(EPERM, fd, 0, PAGE_SIZE, &new_iova);
+	EXPECT_ERRNO(EBUSY, fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE));
+	test_ioctl_ioas_unmap(iova, PAGE_SIZE);
+	ASSERT_EQ(0, fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE));
+	ASSERT_EQ(0, close(fd));
+}
+
 FIXTURE(iommufd_mock_domain)
 {
 	int fd;
-- 
