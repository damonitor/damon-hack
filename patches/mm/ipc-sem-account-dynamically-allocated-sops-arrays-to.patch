diff --git a/ipc/sem.c b/ipc/sem.c
index f2e333383609..16c3f5f7993c 100644
--- a/ipc/sem.c
+++ b/ipc/sem.c
@@ -2251,7 +2251,7 @@ static long do_semtimedop(int semid, struct sembuf __user *tsops,
 		return -EINVAL;
 
 	if (nsops > SEMOPM_FAST) {
-		sops = kvmalloc_objs(*sops, nsops);
+		sops = kvmalloc_objs(*sops, nsops, GFP_KERNEL_ACCOUNT);
 		if (sops == NULL)
 			return -ENOMEM;
 	}
