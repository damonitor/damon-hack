diff --git a/mm/vmalloc.h b/mm/vmalloc.h
index dcfe30eaa80c1..8866ddcff6681 100644
--- a/mm/vmalloc.h
+++ b/mm/vmalloc.h
@@ -5,6 +5,8 @@
