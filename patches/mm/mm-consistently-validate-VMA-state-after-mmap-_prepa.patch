 mm/internal.h                   |  50 +++++++++------
 mm/util.c                       |  19 ++++--
 mm/vma.c                        | 109 ++++++++++++++++++++++++++------
 mm/vma.h                        |  25 +++++++-
 tools/testing/vma/include/dup.h |  10 +++
