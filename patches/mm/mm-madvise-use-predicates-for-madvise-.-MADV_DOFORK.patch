diff --git a/mm/madvise.c b/mm/madvise.c
index bf8b36abef7f..a94c02173004 100644
--- a/mm/madvise.c
+++ b/mm/madvise.c
@@ -1566,7 +1566,7 @@ static int madvise_vma_behavior(struct madvise_behavior *madv_behavior)
 		new_flags |= VM_DONTCOPY;
 		break;
 	case MADV_DOFORK:
-		if (new_flags & VM_SPECIAL)
+		if (!vma_can_merge(vma))
 			return -EINVAL;
 		new_flags &= ~VM_DONTCOPY;
 		break;
