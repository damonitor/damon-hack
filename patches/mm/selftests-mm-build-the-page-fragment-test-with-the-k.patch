From: Andrew Morton <akpm@linux-foundation.org>
Date: Thu, 8 Oct 2026 17:49:06 -0700
Subject: [PATCH] selftests/mm: build the page fragment test with the kernel

The page fragment selftest builds page_frag_test.ko as an external module
under tools/testing/selftests/mm.  With CONFIG_TRIM_UNUSED_KSYMS=y, the
kernel build cannot account for its symbol references.  Exports needed by
the test, such as __cpu_active_mask, can therefore be trimmed before the
selftest module is built, causing modpost to fail.

Building the module from the userspace selftest Makefile also uses the
selftest compiler.  This need not be the compiler used for the kernel: for
example, a nolibc cross compiler can build the kernel but cannot link the
userspace tests, while the native compiler may not support the flags
recorded in the kernel configuration.

Move the module to lib/test_page_frag.c and add CONFIG_TEST_PAGE_FRAG so
that it is built with the kernel and its references are visible to the
normal symbol-trimming pass.  Restrict the option to modules because the
test is invoked explicitly with parameters and returns -EAGAIN after
running, rather than remaining loaded.

Add CONFIG_TEST_PAGE_FRAG=m to tools/testing/selftests/mm/config.  This
file is a kernel configuration fragment listing settings needed by the MM
selftests.  make kselftest-merge merges the fragments from all selftest
directories into the existing kernel .config and runs olddefconfig.  Run
it before building the kernel and modules so that modpost sees the test
module's references and retains the required exports.  Building the
userspace selftests alone does not merge the fragment or enable
CONFIG_TEST_PAGE_FRAG.

Remove the external module build rules and update test_page_frag.sh to
load the installed test_page_frag module with modprobe.  Install the
module for the kernel under test with make modules_install.  Keep the test
implementation and its parameters unchanged.

Fixes: 7fef0dec415c ("mm: page_frag: add a test module for page_frag")
Assisted-by: LLM
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Cc: Yunsheng Lin <linyunsheng@huawei.com>
Cc: Alexander Duyck <alexanderduyck@fb.com>
Cc: Jakub Kicinski <kuba@kernel.org>
Cc: Kevin Brodsky <kevin.brodsky@arm.com>
Cc: Mark Brown <broonie@kernel.org>
Cc: Paolo Abeni <pabeni@redhat.com>
Cc: Shuah Khan <shuah@kernel.org>
Cc: David Hildenbrand <david@kernel.org>
---
 MAINTAINERS                                    |  1 +
 lib/Kconfig.debug                              | 11 +++++++++++
 lib/Makefile                                   |  1 +
 .../page_frag_test.c => lib/test_page_frag.c   |  0
 tools/testing/selftests/mm/Makefile            | 16 ----------------
 tools/testing/selftests/mm/config              |  1 +
 tools/testing/selftests/mm/page_frag/Makefile  | 18 ------------------
 tools/testing/selftests/mm/test_page_frag.sh   | 18 +++++++++---------
 8 files changed, 23 insertions(+), 43 deletions(-)
 rename tools/testing/selftests/mm/page_frag/page_frag_test.c => lib/test_page_frag.c (100%)
 delete mode 100644 tools/testing/selftests/mm/page_frag/Makefile

diff --git a/MAINTAINERS b/MAINTAINERS
index 5c38da7090db..244aa04dbd17 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -17278,6 +17278,7 @@ F:	include/linux/cma.h
 F:	include/linux/dmapool.h
 F:	include/linux/ioremap.h
 F:	include/linux/page_idle.h
+F:	lib/test_page_frag.c
 F:	mm/backing-dev.c
 F:	mm/cma.c
 F:	mm/cma_debug.c
diff --git a/lib/Kconfig.debug b/lib/Kconfig.debug
index 134b15a44625..95e3b9b5e294 100644
--- a/lib/Kconfig.debug
+++ b/lib/Kconfig.debug
@@ -2593,6 +2593,17 @@ config TEST_BITOPS
 
 	  If unsure, say N.
 
+config TEST_PAGE_FRAG
+	tristate "Test module for page fragment allocation"
+	depends on m
+	help
+	  This builds the "test_page_frag" module to test the correctness
+	  and performance of the page fragment allocator. The test runs
+	  at module load time and does not remain loaded after completion.
+	  Use tools/testing/selftests/mm/test_page_frag.sh to run it.
+
+	  If unsure, say N.
+
 config TEST_VMALLOC
 	tristate "Test module for stress/performance analysis of vmalloc allocator"
 	default n
diff --git a/lib/Makefile b/lib/Makefile
index dfab958327c5..69219f7d262f 100644
--- a/lib/Makefile
+++ b/lib/Makefile
@@ -79,6 +79,7 @@ CFLAGS_test_ubsan.o += $(call cc-disable-warning, unused-but-set-variable)
 UBSAN_SANITIZE_test_ubsan.o := y
 obj-$(CONFIG_TEST_KSTRTOX) += test-kstrtox.o
 obj-$(CONFIG_TEST_LKM) += test_module.o
+obj-$(CONFIG_TEST_PAGE_FRAG) += test_page_frag.o
 obj-$(CONFIG_TEST_VMALLOC) += test_vmalloc.o
 obj-$(CONFIG_TEST_WORKQUEUE) += test_workqueue.o
 obj-$(CONFIG_TEST_RHASHTABLE) += test_rhashtable.o
diff --git a/tools/testing/selftests/mm/page_frag/page_frag_test.c b/lib/test_page_frag.c
similarity index 100%
rename from tools/testing/selftests/mm/page_frag/page_frag_test.c
rename to lib/test_page_frag.c
diff --git a/tools/testing/selftests/mm/Makefile b/tools/testing/selftests/mm/Makefile
index beacc0f87304..2a7367a36536 100644
--- a/tools/testing/selftests/mm/Makefile
+++ b/tools/testing/selftests/mm/Makefile
@@ -49,13 +49,6 @@ LDLIBS = -lrt -lpthread -lm
 # warnings.
 CFLAGS += -U_FORTIFY_SOURCE
 
-KDIR ?= $(if $(O),$(O),$(realpath ../../../..))
-ifneq (,$(wildcard $(KDIR)/Module.symvers))
-TEST_GEN_MODS_DIR := page_frag
-else
-PAGE_FRAG_WARNING = "missing Module.symvers, please have the kernel built first"
-endif
-
 TEST_GEN_FILES = cow
 TEST_GEN_FILES += compaction_test
 TEST_GEN_FILES += gup
@@ -279,12 +272,3 @@ warn_missing_liburing:
 	echo "Warning: missing liburing support. Some tests will be skipped." ; \
 	echo
 endif
-
-ifneq ($(PAGE_FRAG_WARNING),)
-all: warn_missing_page_frag
-
-warn_missing_page_frag:
-	@echo ; \
-	echo "Warning: $(PAGE_FRAG_WARNING). page_frag test will be skipped." ; \
-	echo
-endif
diff --git a/tools/testing/selftests/mm/config b/tools/testing/selftests/mm/config
index 06f78bd232e2..bc4ff63a1ad9 100644
--- a/tools/testing/selftests/mm/config
+++ b/tools/testing/selftests/mm/config
@@ -1,6 +1,7 @@
 CONFIG_SYSVIPC=y
 CONFIG_USERFAULTFD=y
 CONFIG_PTE_MARKER_UFFD_WP=y
+CONFIG_TEST_PAGE_FRAG=m
 CONFIG_TEST_VMALLOC=m
 CONFIG_DEVICE_PRIVATE=y
 CONFIG_TEST_HMM=m
diff --git a/tools/testing/selftests/mm/page_frag/Makefile b/tools/testing/selftests/mm/page_frag/Makefile
deleted file mode 100644
index 96e5f646e69b..000000000000
--- a/tools/testing/selftests/mm/page_frag/Makefile
+++ /dev/null
@@ -1,18 +0,0 @@
-PAGE_FRAG_TEST_DIR := $(realpath $(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
-KDIR ?= $(if $(O),$(O),$(realpath ../../../../..))
-
-ifeq ($(V),1)
-Q =
-else
-Q = @
-endif
-
-MODULES = page_frag_test.ko
-
-obj-m += page_frag_test.o
-
-all:
-	+$(Q)make -C $(KDIR) M=$(PAGE_FRAG_TEST_DIR) modules
-
-clean:
-	+$(Q)make -C $(KDIR) M=$(PAGE_FRAG_TEST_DIR) clean
diff --git a/tools/testing/selftests/mm/test_page_frag.sh b/tools/testing/selftests/mm/test_page_frag.sh
index f55b105084cf..a0d44bbf6951 100755
--- a/tools/testing/selftests/mm/test_page_frag.sh
+++ b/tools/testing/selftests/mm/test_page_frag.sh
@@ -11,7 +11,7 @@
 #     a) analyse performance of page fragment allocations;
 #     b) stressing and stability check of page_frag subsystem.
 
-DRIVER="./page_frag/page_frag_test.ko"
+DRIVER="test_page_frag"
 CPU_LIST=$(grep -m 2 processor /proc/cpuinfo | cut -d ' ' -f 2)
 TEST_CPU_0=$(echo $CPU_LIST | awk '{print $1}')
 
@@ -52,13 +52,13 @@ check_test_requirements()
 		exit $ksft_skip
 	fi
 
-	if ! which insmod > /dev/null 2>&1; then
-		echo "$0: You need insmod installed"
+	if ! command -v modprobe > /dev/null 2>&1; then
+		echo "$0: You need modprobe installed"
 		exit $ksft_skip
 	fi
 
-	if [ ! -f $DRIVER ]; then
-		echo "$0: You need to compile page_frag_test module"
+	if ! modinfo "$DRIVER" > /dev/null 2>&1; then
+		echo "$0: You need CONFIG_TEST_PAGE_FRAG=m and the module installed"
 		exit $ksft_skip
 	fi
 }
@@ -67,21 +67,21 @@ run_nonaligned_check()
 {
 	echo "Run performance tests to evaluate how fast nonaligned alloc API is."
 
-	insmod $DRIVER $NONALIGNED_PARAM > /dev/null 2>&1
+	modprobe "$DRIVER" $NONALIGNED_PARAM > /dev/null 2>&1
 }
 
 run_aligned_check()
 {
 	echo "Run performance tests to evaluate how fast aligned alloc API is."
 
-	insmod $DRIVER $ALIGNED_PARAM > /dev/null 2>&1
+	modprobe "$DRIVER" $ALIGNED_PARAM > /dev/null 2>&1
 }
 
 run_smoke_check()
 {
 	echo "Run smoke test."
 
-	insmod $DRIVER $SMOKE_PARAM > /dev/null 2>&1
+	modprobe "$DRIVER" $SMOKE_PARAM > /dev/null 2>&1
 }
 
 usage()
@@ -144,7 +144,7 @@ function run_manual_check()
 	validate_passed_args $@
 
 	echo "Run the test with following parameters: $@"
-	insmod $DRIVER $@ > /dev/null 2>&1
+	modprobe "$DRIVER" "$@" > /dev/null 2>&1
 }
 
 function run_test()
