From: SJ Park <sj@kernel.org>
Date: Sun, 22 Nov 2026 16:25:21 -0800
Subject: [PATCH] Revert "mm/damon/core: apply damos core filter in
 __damos_valid_target()"

This makes kunit fails.  Maybe the test should be updated.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 14 +++++---------
 1 file changed, 5 insertions(+), 9 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 89b4ef4b4ff82..d8a4249371e25 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -2762,20 +2762,12 @@ static noinline_for_stack void kdamond_tune_intervals(struct damon_ctx *c)
 	damon_set_attrs(c, &new_attrs);
 }
 
-static bool damos_core_filter_out(struct damon_ctx *ctx,
-		struct damon_target *t, struct damon_region *r,
-		struct damos *s);
-
 static bool __damos_valid_target(struct damon_region *r, struct damos *s,
 		struct damon_ctx *c, struct damon_target *t)
 {
 	unsigned long sz;
-	unsigned int nr_accesses;
-
-	if (damos_core_filter_out(c, t, r, s))
-		return false;
+	unsigned int nr_accesses = damon_nr_accesses_mvsum(r, c);
 
-	nr_accesses = damon_nr_accesses_mvsum(r, c);
 	sz = damon_sz_region(r);
 	return s->pattern.min_sz_region <= sz &&
 		sz <= s->pattern.max_sz_region &&
@@ -3131,6 +3123,8 @@ static void damos_apply_scheme(struct damon_ctx *c, struct damon_target *t,
 	}
 
 	if (c->ops.apply_scheme) {
+		if (damos_core_filter_out(c, t, r, s))
+			return;
 		if (damos_quota_is_set(quota) &&
 				quota->charged_sz + sz > quota->esz) {
 			sz = ALIGN_DOWN(quota->esz - quota->charged_sz,
@@ -3808,6 +3802,8 @@ static void damos_adjust_quota(struct damon_ctx *c, struct damos *s)
 		damon_for_each_region(r, t) {
 			if (!__damos_valid_target(r, s, c, t))
 				continue;
+			if (damos_core_filter_out(c, t, r, s))
+				continue;
 			score = c->ops.get_scheme_score(c, r, s);
 			c->regions_score_histogram[score] +=
 				damon_sz_region(r);
-- 
2.47.3

