From: SJ Park <sj@kernel.org>
Date: Tue, 20 Oct 2026 18:02:55 -0700
Subject: [PATCH] Revert "mm/damon/sysfs-schemes: hold damon_sysfs_lock in
 target_value_store()"

This reverts commit ddf0ddf11bfb5c568629a53a9a2906397ea89482.

The claimed divide-by-zero cannot happen [1], and therefore the commit
is unnecessary.  Revert.

[1] https://lore.kernel.org/20261021005234.94107-1-sj@kernel.org

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs-schemes.c | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/mm/damon/sysfs-schemes.c b/mm/damon/sysfs-schemes.c
index 2bb5da82caeb6..1ecb257a9120a 100644
--- a/mm/damon/sysfs-schemes.c
+++ b/mm/damon/sysfs-schemes.c
@@ -1358,16 +1358,9 @@ static ssize_t target_value_store(struct kobject *kobj,
 {
 	struct damos_sysfs_quota_goal *goal = container_of(kobj, struct
 			damos_sysfs_quota_goal, kobj);
-	unsigned long target_value;
-	int err = kstrtoul(buf, 0, &target_value);
+	int err = kstrtoul(buf, 0, &goal->target_value);
 
-	if (err)
-		return err;
-	if (!mutex_trylock(&damon_sysfs_lock))
-		return -EBUSY;
-	goal->target_value = target_value;
-	mutex_unlock(&damon_sysfs_lock);
-	return count;
+	return err ? err : count;
 }
 
 static ssize_t current_value_show(struct kobject *kobj,
-- 
2.47.3

