From: SJ Park <sj@kernel.org>
Date: Thu, 24 Sep 2026 12:22:30 -0700
Subject: [PATCH] Revert "mm: memcontrol: drop kmemcg_id and use
 mem_cgroup_id() for list_lru indexing"

This reverts commit 9d7f572e04270bb5d90a9e7d025e5283ae46f04e.

Signed-off-by: SJ Park <sj@kernel.org>
---
 include/linux/memcontrol.h | 16 ++++++++++++++
 mm/list_lru.c              | 27 ++++++++++++------------
 mm/memcontrol.c            | 43 +++++++++++++++++++++++++++++++-------
 3 files changed, 64 insertions(+), 22 deletions(-)

diff --git a/include/linux/memcontrol.h b/include/linux/memcontrol.h
index dc89d46e3d77..74110a324f9e 100644
--- a/include/linux/memcontrol.h
+++ b/include/linux/memcontrol.h
@@ -328,6 +328,8 @@ struct mem_cgroup {
 	/* Private memcg ID. Used to ID objects that outlive the cgroup */
 	int private_id;
 
+	int kmemcg_id;
+
 	/*
 	 * Should the OOM killer kill all belonging tasks, had it kill one?
 	 */
@@ -1818,6 +1820,15 @@ static inline void memcg_kmem_uncharge_page(struct page *page, int order)
 		__memcg_kmem_uncharge_page(page, order);
 }
 
+/*
+ * A helper for accessing memcg's kmem_id, used for getting
+ * corresponding LRU lists.
+ */
+static inline int memcg_kmem_id(const struct mem_cgroup *memcg)
+{
+	return memcg ? memcg->kmemcg_id : -1;
+}
+
 struct mem_cgroup *mem_cgroup_from_virt(void *p);
 
 static inline void count_objcg_events(struct obj_cgroup *objcg,
@@ -1885,6 +1896,11 @@ static inline bool memcg_kmem_online(void)
 	return false;
 }
 
+static inline int memcg_kmem_id(const struct mem_cgroup *memcg)
+{
+	return -1;
+}
+
 static inline struct mem_cgroup *mem_cgroup_from_virt(void *p)
 {
 	return NULL;
diff --git a/mm/list_lru.c b/mm/list_lru.c
index 5c134bf51b5b..d1d256822ccc 100644
--- a/mm/list_lru.c
+++ b/mm/list_lru.c
@@ -72,11 +72,10 @@ static int lru_shrinker_id(struct list_lru *lru)
 }
 
 static inline struct list_lru_one *
-list_lru_from_memcg(struct list_lru *lru, int nid, struct mem_cgroup *memcg)
+list_lru_from_memcg_idx(struct list_lru *lru, int nid, int idx)
 {
-	if (list_lru_memcg_aware(lru) && memcg && !mem_cgroup_is_root(memcg)) {
-		struct list_lru_memcg *mlru =
-			xa_load(&lru->xa, mem_cgroup_id(memcg));
+	if (list_lru_memcg_aware(lru) && idx >= 0) {
+		struct list_lru_memcg *mlru = xa_load(&lru->xa, idx);
 
 		return mlru ? &mlru->node[nid] : NULL;
 	}
@@ -92,7 +91,7 @@ lock_list_lru_of_memcg(struct list_lru *lru, int nid,
 
 	rcu_read_lock();
 again:
-	l = list_lru_from_memcg(lru, nid, *memcg);
+	l = list_lru_from_memcg_idx(lru, nid, memcg_kmem_id(*memcg));
 	if (likely(l)) {
 		lock_list_lru(l, irq, irq_flags);
 		if (likely(READ_ONCE(l->nr_items) != LONG_MIN)) {
@@ -133,7 +132,7 @@ static inline bool list_lru_memcg_aware(struct list_lru *lru)
 }
 
 static inline struct list_lru_one *
-list_lru_from_memcg(struct list_lru *lru, int nid, struct mem_cgroup *memcg)
+list_lru_from_memcg_idx(struct list_lru *lru, int nid, int idx)
 {
 	return &lru->node[nid].lru;
 }
@@ -314,7 +313,7 @@ unsigned long list_lru_count_one(struct list_lru *lru,
 	long count;
 
 	rcu_read_lock();
-	l = list_lru_from_memcg(lru, nid, memcg);
+	l = list_lru_from_memcg_idx(lru, nid, memcg_kmem_id(memcg));
 	count = l ? READ_ONCE(l->nr_items) : 0;
 	rcu_read_unlock();
 
@@ -503,10 +502,11 @@ static void memcg_reparent_list_lru_one(struct list_lru *lru, int nid,
 					struct list_lru_one *src,
 					struct mem_cgroup *dst_memcg)
 {
+	int dst_idx = dst_memcg->kmemcg_id;
 	struct list_lru_one *dst;
 
 	spin_lock_irq(&src->lock);
-	dst = list_lru_from_memcg(lru, nid, dst_memcg);
+	dst = list_lru_from_memcg_idx(lru, nid, dst_idx);
 	spin_lock_nested(&dst->lock, SINGLE_DEPTH_NESTING);
 
 	list_splice_init(&src->list, &dst->list);
@@ -536,7 +536,7 @@ void memcg_reparent_list_lrus(struct mem_cgroup *memcg, struct mem_cgroup *paren
 		 * allocating a new mlru since CSS_DYING is already set for this
 		 * memcg a rcu grace period ago.
 		 */
-		mlru = xa_load(&lru->xa, mem_cgroup_id(memcg));
+		mlru = xa_load(&lru->xa, memcg->kmemcg_id);
 		if (!mlru)
 			continue;
 
@@ -551,7 +551,7 @@ void memcg_reparent_list_lrus(struct mem_cgroup *memcg, struct mem_cgroup *paren
 		for_each_node(i)
 			memcg_reparent_list_lru_one(lru, i, &mlru->node[i], parent);
 
-		xa_erase_irq(&lru->xa, mem_cgroup_id(memcg));
+		xa_erase_irq(&lru->xa, memcg->kmemcg_id);
 
 		/*
 		 * Here all list_lrus corresponding to the cgroup are guaranteed
@@ -566,10 +566,9 @@ void memcg_reparent_list_lrus(struct mem_cgroup *memcg, struct mem_cgroup *paren
 static inline bool memcg_list_lru_allocated(struct mem_cgroup *memcg,
 					    struct list_lru *lru)
 {
-	if (!memcg || mem_cgroup_is_root(memcg))
-		return true;
+	int idx = memcg->kmemcg_id;
 
-	return xa_load(&lru->xa, mem_cgroup_id(memcg));
+	return idx < 0 || xa_load(&lru->xa, idx);
 }
 
 static int __memcg_list_lru_alloc(struct mem_cgroup *memcg,
@@ -603,7 +602,7 @@ static int __memcg_list_lru_alloc(struct mem_cgroup *memcg,
 			if (!mlru)
 				return -ENOMEM;
 		}
-		xas_set(&xas, mem_cgroup_id(pos));
+		xas_set(&xas, pos->kmemcg_id);
 		do {
 			xas_lock_irqsave(&xas, flags);
 			if (!xas_load(&xas) && !css_is_dying(&pos->css)) {
diff --git a/mm/memcontrol.c b/mm/memcontrol.c
index 5d7a26c91610..aad0498a7bd6 100644
--- a/mm/memcontrol.c
+++ b/mm/memcontrol.c
@@ -3807,6 +3807,33 @@ void folio_split_memcg_refs(struct folio *folio, unsigned old_order,
 	obj_cgroup_get_many(folio_objcg(folio), new_refs);
 }
 
+static void memcg_online_kmem(struct mem_cgroup *memcg)
+{
+	if (mem_cgroup_kmem_disabled())
+		return;
+
+	if (unlikely(mem_cgroup_is_root(memcg)))
+		return;
+
+	static_branch_enable(&memcg_kmem_online_key);
+
+	memcg->kmemcg_id = memcg->private_id;
+}
+
+static void memcg_offline_kmem(struct mem_cgroup *memcg)
+{
+	struct mem_cgroup *parent;
+
+	if (mem_cgroup_kmem_disabled())
+		return;
+
+	if (unlikely(mem_cgroup_is_root(memcg)))
+		return;
+
+	parent = parent_mem_cgroup(memcg);
+	memcg_reparent_list_lrus(memcg, parent);
+}
+
 #ifdef CONFIG_CGROUP_WRITEBACK
 
 #include <trace/events/writeback.h>
@@ -4282,6 +4309,7 @@ static struct mem_cgroup *mem_cgroup_alloc(struct mem_cgroup *parent)
 	seqlock_init(&memcg->socket_pressure_seqlock);
 #endif
 	memcg1_memcg_init(memcg);
+	memcg->kmemcg_id = -1;
 #ifdef CONFIG_CGROUP_WRITEBACK
 	INIT_LIST_HEAD(&memcg->cgwb_list);
 	for (i = 0; i < MEMCG_CGWB_FRN_CNT; i++)
@@ -4355,8 +4383,7 @@ static int mem_cgroup_css_online(struct cgroup_subsys_state *css)
 	struct obj_cgroup *objcg;
 	int nid;
 
-	if (!mem_cgroup_kmem_disabled() && likely(!mem_cgroup_is_root(memcg)))
-		static_branch_enable(&memcg_kmem_online_key);
+	memcg_online_kmem(memcg);
 
 	/*
 	 * A memcg must be visible for expand_shrinker_info()
@@ -4364,7 +4391,7 @@ static int mem_cgroup_css_online(struct cgroup_subsys_state *css)
 	 * here, when mem_cgroup_iter() can't skip it.
 	 */
 	if (alloc_shrinker_info(memcg))
-		goto reparent_lrus;
+		goto offline_kmem;
 
 	for_each_node(nid) {
 		objcg = obj_cgroup_alloc();
@@ -4422,8 +4449,8 @@ static int mem_cgroup_css_online(struct cgroup_subsys_state *css)
 		}
 	}
 	free_shrinker_info(memcg);
-reparent_lrus:
-	memcg_reparent_list_lrus(memcg, parent_mem_cgroup(memcg));
+offline_kmem:
+	memcg_offline_kmem(memcg);
 	mem_cgroup_private_id_remove(memcg);
 	return -ENOMEM;
 }
@@ -4439,11 +4466,11 @@ static void mem_cgroup_css_offline(struct cgroup_subsys_state *css)
 
 	zswap_memcg_offline_cleanup(memcg);
 
-	memcg_reparent_list_lrus(memcg, parent_mem_cgroup(memcg));
+	memcg_offline_kmem(memcg);
 	/*
 	 * The reparenting of objcg must be after the reparenting of
-	 * the list_lru above, which ensures that they will not
-	 * mistakenly get the parent list_lru.
+	 * the list_lru in memcg_offline_kmem(), which ensures that
+	 * they will not mistakenly get the parent list_lru.
 	 */
 	memcg_reparent_objcgs(memcg);
 	reparent_shrinker_deferred(memcg);
-- 
2.47.3

