From: SJ Park <sj@kernel.org>
Date: Thu, 24 Sep 2026 12:22:30 -0700
Subject: [PATCH] Revert "mm: zswap: mark the zswap shrinker SHRINKER_NONSLAB"

This reverts commit 0454a99f04d4bdf9a9d7336d15734ef3bbfc4ed8.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/zswap.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mm/zswap.c b/mm/zswap.c
index eb3494491410..ae19e301fced 100644
--- a/mm/zswap.c
+++ b/mm/zswap.c
@@ -1297,8 +1297,8 @@ static struct shrinker *zswap_alloc_shrinker(void)
 {
 	struct shrinker *shrinker;
 
-	shrinker = shrinker_alloc(SHRINKER_NUMA_AWARE | SHRINKER_MEMCG_AWARE |
-				  SHRINKER_NONSLAB, "mm-zswap");
+	shrinker =
+		shrinker_alloc(SHRINKER_NUMA_AWARE | SHRINKER_MEMCG_AWARE, "mm-zswap");
 	if (!shrinker)
 		return NULL;
 
-- 
2.47.3

