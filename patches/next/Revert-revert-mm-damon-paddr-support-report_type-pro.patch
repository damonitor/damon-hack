From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 13:48:25 -0800
Subject: [PATCH] Revert "revert mm/damon/paddr: support report_type probe
 filter"

This reverts commit 2d4aff2e104b0aac730fb9131eb25cfa64c57eb3.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index ff85b5d9c8f72..1b6c74372362b 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -143,6 +143,7 @@ static bool damon_pa_filter_match(struct damon_filter *filter,
 		struct folio *folio, phys_addr_t pa, struct damon_ctx *ctx)
 {
 	bool matched = false;
+	struct damon_addr_range addr_range;
 
 	switch (filter->type) {
 	case DAMON_FILTER_TYPE_PGIDLE_UNSET:
@@ -157,6 +158,13 @@ static bool damon_pa_filter_match(struct damon_filter *filter,
 		else
 			matched = damon_folio_young(folio) == false;
 		break;
+	case DAMON_FILTER_TYPE_REPORT:
+		addr_range.start = filter->report_addr_start;
+		addr_range.end = filter->report_addr_end;
+		matched = damon_report_exist(filter->report_type,
+				&addr_range, jiffies -
+				usecs_to_jiffies(ctx->attrs.sample_interval));
+		break;
 	default:
 		return damon_ops_filter_match(filter, folio);
 	}
-- 
2.47.3

