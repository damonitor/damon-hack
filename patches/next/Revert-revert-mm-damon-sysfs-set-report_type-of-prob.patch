From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 13:48:25 -0800
Subject: [PATCH] Revert "revert mm/damon/sysfs: set report_type of probe
 filter"

This reverts commit 2d6651243d657a622bad662d46c0032f8e75d820.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index fb8f758387ab4..055efac931a21 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2340,6 +2340,8 @@ static int damon_sysfs_set_filters(struct damon_probe *probe,
 		} else if (filter->type == DAMON_FILTER_TYPE_HUGEPAGE_SIZE) {
 			filter->range_min = sys_filter->range_min;
 			filter->range_max = sys_filter->range_max;
+		} else if (filter->type == DAMON_FILTER_TYPE_REPORT) {
+			filter->report_type = sys_filter->report_type;
 		}
 		damon_add_filter(probe, filter);
 	}
-- 
2.47.3

