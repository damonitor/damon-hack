From: SJ Park <sj@kernel.org>
Date: Sat, 25 Jul 2026 10:53:51 -0700
Subject: [PATCH] de_activate fixup

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 8 +-------
 1 file changed, 1 insertion(+), 7 deletions(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index 18c88080641e3..4b8beac3b47e0 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -390,17 +390,11 @@ static inline unsigned long damon_pa_de_activate(
 
 	addr = damon_pa_phys_addr(r->ar.start, addr_unit);
 	while (addr < damon_pa_phys_addr(r->ar.end, addr_unit)) {
-		phys_addr_t folio_addr;
-
 		folio = damon_get_folio(PHYS_PFN(addr));
 		if (damon_pa_invalid_damos_folio(folio, s)) {
 			addr += PAGE_SIZE;
 			continue;
 		}
-		folio_addr = PFN_PHYS(folio_pfn(folio));
-		if (folio_addr < addr)
-			goto put_folio;
-
 		if (damos_pa_filter_out(s, folio))
 			goto put_folio;
 		else
@@ -412,7 +406,7 @@ static inline unsigned long damon_pa_de_activate(
 			folio_deactivate(folio);
 		applied += folio_nr_pages(folio);
 put_folio:
-		addr = folio_addr + folio_size(folio);
+		addr = PFN_PHYS(folio_pfn(folio)) + folio_size(folio);
 		folio_put(folio);
 	}
 	s->last_applied = folio;
-- 
2.47.3

