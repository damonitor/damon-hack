From: SJ Park <sj@kernel.org>
Date: Mon, 27 Jul 2026 20:46:54 -0700
Subject: [PATCH] fs/erofs/Kconfig: temporal !SMP build fix

Link: https://lore.kernel.org/20260728034633.104580-1-sj@kernel.org

Signed-off-by: SJ Park <sj@kernel.org>
---
 fs/erofs/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/fs/erofs/Kconfig b/fs/erofs/Kconfig
index 8ca1767dafb61..f75144606ad13 100644
--- a/fs/erofs/Kconfig
+++ b/fs/erofs/Kconfig
@@ -134,7 +134,7 @@ config EROFS_FS_ZIP_LZMA
 config EROFS_FS_ZIP_LZMA_DEFAULT_MAX_STREAMS
 	int "EROFS LZMA default maximum decompression streams"
 	depends on EROFS_FS_ZIP_LZMA
-	range 1 NR_CPUS
+	range 1 1024
 	default 16
 	help
 	  By default EROFS allocates one LZMA decompression stream per CPU.
-- 
2.47.3

