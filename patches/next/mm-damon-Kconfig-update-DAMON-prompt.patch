Subject: [PATCH] mm/damon/Kconfig: update DAMON prompt

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/damon/Kconfig b/mm/damon/Kconfig
index 47910e2cadf8..961849a4f756 100644
--- a/mm/damon/Kconfig
+++ b/mm/damon/Kconfig
@@ -3,7 +3,7 @@
 menu "DAMON"
 
 config DAMON
-	bool "DAMON: Data Access Monitoring Framework"
