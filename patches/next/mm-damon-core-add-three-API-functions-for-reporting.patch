From: SJ Park <sj@kernel.org>
Date: Wed, 11 Nov 2026 12:16:00 -0800
Subject: [PATCH] mm/damon/core: add three API functions for reporting

Signed-off-by: SJ Park <sj@kernel.org>
---
 include/linux/damon.h |  4 ++++
 mm/damon/core.c       | 16 ++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/include/linux/damon.h b/include/linux/damon.h
index 005d1ca2b0c26..d7aa9bd86cd48 100644
--- a/include/linux/damon.h
+++ b/include/linux/damon.h
@@ -1352,6 +1352,10 @@ int damon_kdamond_pid(struct damon_ctx *ctx);
 int damon_call(struct damon_ctx *ctx, struct damon_call_control *control);
 int damos_walk(struct damon_ctx *ctx, struct damos_walk_control *control);
 
+int damon_enable_report_producer(enum damon_report_type, unsigned int id);
+int damon_disable_report_producer(unsigned int id);
+int damon_submit_report(struct damon_report *report);
+
 void damon_report_access(struct damon_access_report *report);
 #ifdef CONFIG_MMU
 void damon_report_page_fault(struct vm_fault *vmf, bool huge_pmd);
diff --git a/mm/damon/core.c b/mm/damon/core.c
index d1447b1b7bf0c..94413223b2a82 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -2512,6 +2512,22 @@ int damos_walk(struct damon_ctx *ctx, struct damos_walk_control *control)
 	return 0;
 }
 
+int damon_enable_report_producer(enum damon_report_type, unsigned int id)
+{
+	return 0;
+}
+
+int damon_disable_report_producer(unsigned int id)
+{
+	return 0;
+}
+
+int damon_submit_report(struct damon_report *report)
+{
+	return 0;
+}
+
+
 /**
  * damon_report_access() - Report identified access events to DAMON.
  * @report:	The reporting access information.
-- 
2.47.3

