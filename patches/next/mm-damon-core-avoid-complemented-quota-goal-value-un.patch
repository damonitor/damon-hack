From: SJ Park <sj@kernel.org>
Date: Fri, 18 Sep 2026 07:58:47 -0700
Subject: [PATCH] mm/damon/core: avoid complemented quota goal value underflow

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 235235d557974..e36366c16737f 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -3476,11 +3476,15 @@ static void damos_set_quota_goal_current_value(struct damon_ctx *c,
 	/* for user_input, users set complemented value on their own */
 	if (goal->metric == DAMOS_QUOTA_USER_INPUT)
 		return;
-	if (goal->metric == DAMOS_QUOTA_SOME_MEM_PSI_US)
+	if (goal->metric == DAMOS_QUOTA_SOME_MEM_PSI_US) {
 		goal->current_value = s->quota.reset_interval * 1000 -
 			goal->current_value;
-	else
+		return;
+	}
+	if (goal->current_value < 10000)
 		goal->current_value = 10000 - goal->current_value;
+	else
+		gaol->current_value = 0;
 }
 
 /* Return the highest score since it makes schemes least aggressive */
-- 
2.47.3

