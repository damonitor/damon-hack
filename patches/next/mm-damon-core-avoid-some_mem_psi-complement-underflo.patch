From: SJ Park <sj@kernel.org>
Date: Fri, 18 Sep 2026 18:30:38 -0700
Subject: [PATCH] mm/damon/core: avoid some_mem_psi complement underflow

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 2d2b699064577..4760c88c9407b 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -3477,8 +3477,11 @@ static void damos_set_quota_goal_current_value(struct damon_ctx *c,
 	if (goal->metric == DAMOS_QUOTA_USER_INPUT)
 		return;
 	if (goal->metric == DAMOS_QUOTA_SOME_MEM_PSI_US) {
-		goal->current_value = s->quota.reset_interval * 1000 -
-			goal->current_value;
+		if (goal->current_value < s->quota.reset_interval * 1000)
+			goal->current_value = s->quota.reset_interval * 1000 -
+				goal->current_value;
+		else
+			goal->current_value = 0;
 		return;
 	}
 	if (goal->current_value < 10000)
-- 
2.47.3

