From: SJ Park <sj@kernel.org>
Date: Sun, 13 Sep 2026 10:40:24 -0700
Subject: [PATCH] mm/damon/core: commit range_min,max for new hugepage_size
 filter

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 8f99a623441dd..4571ec73bb570 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1954,6 +1954,12 @@ static int damon_commit_filters(struct damon_probe *dst,
 		case DAMON_FILTER_TYPE_MEMCG:
 			new_filter->memcg_id = src_filter->memcg_id;
 			break;
+		case DAMON_FILTER_TYPE_HUGEPAGE_SIZE:
+			if (src->range_max < src->range_min)
+				return -EINVAL;
+			dst->range_min = src->range_min;
+			dst->range_max = src->range_max;
+			break;
 		default:
 			break;
 		}
-- 
2.47.3

