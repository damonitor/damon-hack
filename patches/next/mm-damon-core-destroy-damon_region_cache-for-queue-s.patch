From: SJ Park <sj@kernel.org>
Date: Sun, 15 Nov 2026 13:16:54 -0800
Subject: [PATCH] mm/damon/core: destroy damon_region_cache for queue setup
 fail (patch 2 fixup)

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index df3fe1e78d7a0..3bb5080b216b6 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -4757,7 +4757,7 @@ void damon_update_region_access_rate(struct damon_region *r, bool accessed)
  */
 bool damon_initialized(void)
 {
-	return damon_region_cache && damon_report_queue.reports;
+	return damon_region_cache;
 }
 
 static int __init damon_init(void)
@@ -4773,6 +4773,8 @@ static int __init damon_init(void)
 			1000, GFP_KERNEL);
 	if (!damon_report_queue.reports) {
 		pr_err("report queue alloc fail\n");
+		kmem_cache_destroy(damon_region_cache);
+		damon_region_cache = NULL;
 		return -ENOMEM;
 	}
 
-- 
2.47.3

