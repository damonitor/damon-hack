From: SJ Park <sj@kernel.org>
Date: Sun, 15 Nov 2026 13:23:14 -0800
Subject: [PATCH] mm/damon/core: fix queue out-of-bounds writing (patch 3
 fixup)

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index d646922bdf87d..9d492a9aaf550 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -2365,7 +2365,6 @@ int damon_submit_report(struct damon_report *report)
 {
 	struct damon_report_queue *queue;
 	int lock_old_val;
-	unsigned int tail;
 
 	queue = &damon_report_queue;
 	report->jiffies = jiffies;
@@ -2373,10 +2372,9 @@ int damon_submit_report(struct damon_report *report)
 	if (lock_old_val)
 		return -EBUSY;
 
-	tail = queue->tail;
-	if (tail == queue->size)
-		tail = 0;
-	queue->reports[tail] = *report;
+	if (queue->tail == queue->size)
+		queue->tail = 0;
+	queue->reports[queue->tail] = *report;
 	queue->tail++;
 	if (queue->nr_reports < queue->size)
 		queue->nr_reports++;
-- 
2.47.3

