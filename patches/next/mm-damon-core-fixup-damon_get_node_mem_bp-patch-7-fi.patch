From: SJ Park <sj@kernel.org>
Date: Sun, 2 Aug 2026 11:01:58 -0700
Subject: [PATCH] mm/damon/core: fixup damon_get_node_mem_bp (patch 7 fixup)

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 30c049f9a44cc..daab1e7d66ca0 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -3128,16 +3128,17 @@ static __kernel_ulong_t damos_get_node_mem_bp(
 	}
 
 	si_meminfo_node(&i, goal->nid);
-	if (!i.totalram)
-		return 10000;
-	if (goal->metric == DAMOS_QUOTA_NODE_MEM_USED_BP) {
-		numerator = i.totalram - i.freeram;
-	} else {
-		/* DAMOS_QUOTA_NODE_MEM_FREE_BP */
-		if (i.totalram < i.freeram)
+	if (!i.totalram || i.totalram < i.freeram) {
+		if (goal->metric == DAMOS_QUOTA_NODE_MEM_USED_BP)
+			return 10000;
+		else	/* DAMOS_QUOTA_NODE_MEM_FREE_BP */
 			return 0;
-		numerator = i.freeram;
 	}
+
+	if (goal->metric == DAMOS_QUOTA_NODE_MEM_USED_BP)
+		numerator = i.totalram - i.freeram;
+	else	/* DAMOS_QUOTA_NODE_MEM_FREE_BP */
+		numerator = i.freeram;
 	return mult_frac(numerator, 10000, i.totalram);
 }
 
