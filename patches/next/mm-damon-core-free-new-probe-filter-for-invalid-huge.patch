From: SJ Park <sj@kernel.org>
Date: Mon, 14 Sep 2026 08:01:05 -0700
Subject: [PATCH] mm/damon/core: free new probe filter for invalid
 hugepage_size range

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 4b270615e2156..b6ffeae1b2e1d 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1955,8 +1955,10 @@ static int damon_commit_filters(struct damon_probe *dst,
 			new_filter->memcg_id = src_filter->memcg_id;
 			break;
 		case DAMON_FILTER_TYPE_HUGEPAGE_SIZE:
-			if (src_filter->range_max < src_filter->range_min)
+			if (src_filter->range_max < src_filter->range_min) {
+				damon_destroy_filter(new_filter);
 				return -EINVAL;
+			}
 			new_filter->range_min = src_filter->range_min;
 			new_filter->range_max = src_filter->range_max;
 			break;
-- 
2.47.3

