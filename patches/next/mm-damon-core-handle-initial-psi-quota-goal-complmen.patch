From: SJ Park <sj@kernel.org>
Date: Wed, 23 Sep 2026 02:57:55 -0700
Subject: [PATCH] mm/damon/core: handle initial psi quota goal complment

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index a551b77fbc89..b560fea41f93 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -3189,10 +3189,18 @@ static void damos_set_psi_current_val(u64 now_psi_total,
 		struct damos_quota_goal *goal, struct damos *s)
 {
 	u64 last_psi_total = goal->last_psi_total;
+	unsigned long val;
 
 	goal->last_psi_total = now_psi_total;
 	if (last_psi_total != U64_MAX) {
-		goal->current_value = now_psi_total - last_psi_total;
+		val = now_psi_total - last_psi_total;
+		if (goal->complement) {
+			if (val < s->quota.reset_interval * 1000)
+				val = s->quota.reset_interval * 1000 - val;
+			else
+				val = 0;
+		}
+		goal->current_value = val;
 		return;
 	}
 	/* uninitialized last_psi_total; make no effect this round */
@@ -3492,14 +3500,9 @@ static void damos_set_quota_goal_current_value(struct damon_ctx *c,
 	/* for user_input, users set complemented value on their own */
 	if (goal->metric == DAMOS_QUOTA_USER_INPUT)
 		return;
-	if (goal->metric == DAMOS_QUOTA_SOME_MEM_PSI_US) {
-		if (goal->current_value < s->quota.reset_interval * 1000)
-			goal->current_value = s->quota.reset_interval * 1000 -
-				goal->current_value;
-		else
-			goal->current_value = 0;
+	/* damos_set_psi_current_val() handles complement flag itself */
+	if (goal->metric == DAMOS_QUOTA_SOME_MEM_PSI_US)
 		return;
-	}
 	if (goal->current_value < 10000)
 		goal->current_value = 10000 - goal->current_value;
 	else
-- 
2.47.3

