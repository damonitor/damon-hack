From: SJ Park <sj@kernel.org>
Date: Wed, 11 Nov 2026 12:40:33 -0800
Subject: [PATCH] mm/damon/core: initialize damon_report_queue

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index d5ca216dec0ce..0aba75a044ca5 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -4682,7 +4682,7 @@ void damon_update_region_access_rate(struct damon_region *r, bool accessed)
  */
 bool damon_initialized(void)
 {
-	return damon_region_cache != NULL;
+	return damon_region_cache && damon_report_queue.reports;
 }
 
 static int __init damon_init(void)
@@ -4693,6 +4693,13 @@ static int __init damon_init(void)
 		return -ENOMEM;
 	}
 
+	/* lock, head, tail are set to 0, since static variable */
+	damon_report_queue.size = 1000;
+	damon_report_queu.reports = kmalloc_objs(*damon_report_queue.reports,
+			1000, GFP_KERNEL);
+	if (!damon_report_queue.reports)
+		return -ENOMEM;
+
 	return 0;
 }
 
-- 
