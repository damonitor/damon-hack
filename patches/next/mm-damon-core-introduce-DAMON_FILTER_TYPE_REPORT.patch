From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 13:48:23 -0800
Subject: [PATCH] mm/damon/core: introduce DAMON_FILTER_TYPE_REPORT

Extend DAMON probe filter for data attribute reports.  Define a new
filter type for the purpose.  Add union argument for specifying the type
of the reports for the filter.

Signed-off-by: SJ Park <sj@kernel.org>
---
 include/linux/damon.h | 7 +++++++
 mm/damon/core.c       | 6 ++++++
 2 files changed, 13 insertions(+)

diff --git a/include/linux/damon.h b/include/linux/damon.h
index ca0135c6f6700..a0b1d51c9c155 100644
--- a/include/linux/damon.h
+++ b/include/linux/damon.h
@@ -804,6 +804,7 @@ struct damon_prep {
  * @DAMON_FILTER_TYPE_PGIDLE_SET:	Pgidle is set.
  * @DAMON_FILTER_TYPE_HUGEPAGE_SIZE:	Page is part of a hugepage.
  * @DAMON_FILTER_TYPE_ACTIVE:		LRU-active pages.
+ * @DAMON_FILTER_TYPE_REPORT:		Report exists.
  */
 enum damon_filter_type {
 	DAMON_FILTER_TYPE_ANON,
@@ -812,6 +813,7 @@ enum damon_filter_type {
 	DAMON_FILTER_TYPE_PGIDLE_SET,
 	DAMON_FILTER_TYPE_HUGEPAGE_SIZE,
 	DAMON_FILTER_TYPE_ACTIVE,
+	DAMON_FILTER_TYPE_REPORT,
 };
 
 /**
@@ -834,6 +836,11 @@ struct damon_filter {
 			unsigned long range_min;
 			unsigned long range_max;
 		};
+		struct {
+			enum damon_report_type report_type;
+			unsigned long report_addr_start;
+			unsigned long report_addr_end;
+		};
 	};
 /* private: */
 	/* Siblings list. */
diff --git a/mm/damon/core.c b/mm/damon/core.c
index 06b85d00e38d9..69a2085328c2b 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1834,6 +1834,12 @@ static int damon_commit_filter(struct damon_filter *dst,
 		dst->range_min = src->range_min;
 		dst->range_max = src->range_max;
 		break;
+	case DAMON_FILTER_TYPE_REPORT:
+		if (src->report_addr_start < src->report_addr_end)
+			return -EINVAL;
+		dst->report_type = src->report_type;
+		dst->report_addr_start = src->report_addr_start;
+		dst->report_addr_end = src->report_addr_end;
 	default:
 		break;
 	}
-- 
2.47.3

