From: SJ Park <sj@kernel.org>
Date: Fri, 18 Sep 2026 18:34:16 -0700
Subject: [PATCH] mm/damon/core[-kunit]: set complement param for
 damos_new_quota_goal()

It doesn't cause real issues.  But it may degrade readability and
confuse future tests.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c             | 4 ++--
 mm/damon/tests/core-kunit.h | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 4760c88c9407b..e0e26548b4e48 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1346,8 +1346,8 @@ int damos_commit_quota_goals(struct damos_quota *dst, struct damos_quota *src)
 	damos_for_each_quota_goal_safe(src_goal, next, src) {
 		if (j++ < i)
 			continue;
-		new_goal = damos_new_quota_goal(src_goal->metric, false,
-				src_goal->target_value);
+		new_goal = damos_new_quota_goal(src_goal->metric,
+				src_goal->complement, src_goal->target_value);
 		if (!new_goal)
 			return -ENOMEM;
 		err = damos_commit_quota_goal(new_goal, src_goal);
diff --git a/mm/damon/tests/core-kunit.h b/mm/damon/tests/core-kunit.h
index a2504e96954f7..6a13d9bd377cb 100644
--- a/mm/damon/tests/core-kunit.h
+++ b/mm/damon/tests/core-kunit.h
@@ -931,7 +931,8 @@ static void damos_test_commit_quota_goals_for(struct kunit *test,
 		 * damos_commit_quota_goals() will kfree() the dst goals.
 		 * Make it kfree()-able.
 		 */
-		goal = damos_new_quota_goal(dst_goals[i].metric, false,
+		goal = damos_new_quota_goal(dst_goals[i].metric,
+				dst_goals[i].complementfalse,
 				dst_goals[i].target_value);
 		if (!goal)
 			goto out;
-- 
2.47.3

