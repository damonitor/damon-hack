From: SJ Park <sj@kernel.org>
Date: Wed, 11 Nov 2026 16:11:25 -0800
Subject: [PATCH] mm/damon/core: print error for initial queue alloc failure

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index ce28d060a16d7..e60b6aa4cdfad 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -4766,8 +4766,10 @@ static int __init damon_init(void)
 	damon_report_queue.size = 1000;
 	damon_report_queue.reports = kmalloc_objs(*damon_report_queue.reports,
 			1000, GFP_KERNEL);
-	if (!damon_report_queue.reports)
+	if (!damon_report_queue.reports) {
+		pr_err("report queue alloc fail\n");
 		return -ENOMEM;
+	}
 
 	return 0;
 }
-- 
2.47.3

