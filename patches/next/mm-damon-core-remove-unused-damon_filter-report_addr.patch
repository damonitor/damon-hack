From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 15:29:00 -0800
Subject: [PATCH] mm/damon/core: remove unused
 damon_filter->report_addr_start,end

Those are not really being used.  Remove.

Signed-off-by: SJ Park <sj@kernel.org>
---
 include/linux/damon.h | 6 +-----
 mm/damon/core.c       | 4 ----
 2 files changed, 1 insertion(+), 9 deletions(-)

diff --git a/include/linux/damon.h b/include/linux/damon.h
index d960c0cb81adb..414eeaec32430 100644
--- a/include/linux/damon.h
+++ b/include/linux/damon.h
@@ -897,11 +897,7 @@ struct damon_filter {
 			unsigned long range_min;
 			unsigned long range_max;
 		};
-		struct {
-			enum damon_report_type report_type;
-			unsigned long report_addr_start;
-			unsigned long report_addr_end;
-		};
+		enum damon_report_type report_type;
 	};
 /* private: */
 	/* Siblings list. */
diff --git a/mm/damon/core.c b/mm/damon/core.c
index fe691aff88c5e..456d90cf196c6 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1919,11 +1919,7 @@ static int damon_commit_filter(struct damon_filter *dst,
 		dst->range_max = src->range_max;
 		break;
 	case DAMON_FILTER_TYPE_REPORT:
-		if (src->report_addr_start < src->report_addr_end)
-			return -EINVAL;
 		dst->report_type = src->report_type;
-		dst->report_addr_start = src->report_addr_start;
-		dst->report_addr_end = src->report_addr_end;
 	default:
 		break;
 	}
-- 
2.47.3

