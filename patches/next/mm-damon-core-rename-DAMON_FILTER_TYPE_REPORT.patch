From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 15:56:43 -0800
Subject: [PATCH] mm/damon/core: rename DAMON_FILTER_TYPE_REPORT

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 456d90cf196c6..f682473cb93a5 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1918,7 +1918,7 @@ static int damon_commit_filter(struct damon_filter *dst,
 		dst->range_min = src->range_min;
 		dst->range_max = src->range_max;
 		break;
-	case DAMON_FILTER_TYPE_REPORT:
+	case DAMON_FILTER_TYPE_REPORT_MADE:
 		dst->report_type = src->report_type;
 	default:
 		break;
