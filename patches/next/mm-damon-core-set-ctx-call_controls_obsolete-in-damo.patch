From: SJ Park <sj@kernel.org>
Date: Tue, 4 Aug 2026 07:14:18 -0700
Subject: [PATCH] mm/damon/core: set ctx->call_controls_obsolete in
 damon_new_ctx()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index be8e2a0c09fc9..197ed1a1fffe6 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -999,6 +999,7 @@ struct damon_ctx *damon_new_ctx(void)
 	INIT_LIST_HEAD(&ctx->adaptive_targets);
 	INIT_LIST_HEAD(&ctx->schemes);
 
+	ctx->call_control_obsolete = true;
 	prandom_seed_state(&ctx->rnd_state, get_random_u64());
 
 	return ctx;
-- 
