From: SJ Park <sj@kernel.org>
Date: Sun, 15 Nov 2026 13:27:52 -0800
Subject: [PATCH] mm/damon/core: set damon_filter->report_type in filters
 commit (patch 12 fixup)

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 9d1bcb9a76db6..5f55767cda9a6 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1964,6 +1964,9 @@ static int damon_commit_filters(struct damon_probe *dst,
 			new_filter->range_min = src_filter->range_min;
 			new_filter->range_max = src_filter->range_max;
 			break;
+		case DAMON_FILTER_TYPE_REPORT_MADE:
+			new_filter->report_type = src_filter->report_type;
+			break;
 		default:
 			break;
 		}
-- 
