From: SJ Park <sj@kernel.org>
Date: Wed, 26 Aug 2026 20:54:55 -0700
Subject: [PATCH] mm/damon/core: set last_psi_total in commit_quota_goal()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index ac7ee32229cd4..c2eeb2ee0f140 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1275,6 +1275,9 @@ static void damos_commit_quota_goal_union(
 		struct damos_quota_goal *dst, struct damos_quota_goal *src)
 {
 	switch (dst->metric) {
+	case DAMOS_QUOTA_SOME_MEM_PSI_US:
+		dst->last_psi_total = damos_get_some_mem_psi_total();
+		break;
 	case DAMOS_QUOTA_NODE_MEM_USED_BP:
 	case DAMOS_QUOTA_NODE_MEM_FREE_BP:
 		dst->nid = src->nid;
-- 
2.47.3

