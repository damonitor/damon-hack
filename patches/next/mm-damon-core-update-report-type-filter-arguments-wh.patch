From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 13:50:50 -0800
Subject: [PATCH] mm/damon/core: update report type filter arguments when
 commit

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index ac1ad312d743c..fe691aff88c5e 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1918,6 +1918,12 @@ static int damon_commit_filter(struct damon_filter *dst,
 		dst->range_min = src->range_min;
 		dst->range_max = src->range_max;
 		break;
+	case DAMON_FILTER_TYPE_REPORT:
+		if (src->report_addr_start < src->report_addr_end)
+			return -EINVAL;
+		dst->report_type = src->report_type;
+		dst->report_addr_start = src->report_addr_start;
+		dst->report_addr_end = src->report_addr_end;
 	default:
 		break;
 	}
-- 
2.47.3

