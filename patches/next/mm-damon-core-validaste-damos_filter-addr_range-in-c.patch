From: SJ Park <sj@kernel.org>
Date: Thu, 10 Sep 2026 18:05:05 -0700
Subject: [PATCH] mm/damon/core: validaste damos_filter->addr_range in
 commit_fitler_arg()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index ff198e2f105c9..b29b5f19bdb91 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1410,6 +1410,8 @@ static int damos_commit_filter_arg(
 		dst->memcg_id = src->memcg_id;
 		break;
 	case DAMOS_FILTER_TYPE_ADDR:
+		if (src->addr_range.end < src->addr_range.start)
+			return -EINVAL;
 		dst->addr_range = src->addr_range;
 		break;
 	case DAMOS_FILTER_TYPE_TARGET:
-- 
2.47.3

