From: SJ Park <sj@kernel.org>
Date: Thu, 10 Sep 2026 18:03:34 -0700
Subject: [PATCH] mm/damon/core: validate sz_range in damos_commit_filter_arg()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/core.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mm/damon/core.c b/mm/damon/core.c
index 29bbc62f63b55..6b32d82131033 100644
--- a/mm/damon/core.c
+++ b/mm/damon/core.c
@@ -1416,6 +1416,8 @@ static int damos_commit_filter_arg(
 		dst->target_idx = src->target_idx;
 		break;
 	case DAMOS_FILTER_TYPE_HUGEPAGE_SIZE:
+		if (src->sz_range.max < src->sz_range.min)
+			return -EINVAL;
 		dst->sz_range = src->sz_range;
 		break;
 	case DAMOS_FILTER_TYPE_PROBE_HITS_WSUM:
-- 
2.47.3

