From: SJ Park <sj@kernel.org>
Date: Mon, 23 Nov 2026 06:25:01 -0800
Subject: [PATCH] mm/damon/paddr: fixup probing memory core address range setup

Tested-by: Lian Wang <lianux.mm@gmail.com>
Signed-off-by: Lian Wang <lianux.mm@gmail.com>
Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index be3283456009b..2292f0d1aca97 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -225,7 +225,7 @@ static bool damon_pa_filter_match(struct damon_filter *filter,
 		break;
 	case DAMON_FILTER_TYPE_REPORT_MADE:
 		addr_range.start = damon_pa_core_addr(pa, ctx->addr_unit);
-		addr_range.end = damon_pa_core_addr(pa + 1, ctx->addr_unit);
+		addr_range.end = addr_range.start + 1;
 		matched = damon_report_exist(filter->report_type, &addr_range,
 				jiffies -
 				usecs_to_jiffies(ctx->attrs.sample_interval));
-- 
2.47.3

