From: SJ Park <sj@kernel.org>
Date: Thu, 23 Jul 2026 07:45:25 -0700
Subject: [PATCH] mm/damon/paddr: respect folio end for DAMOS_MIGRATE

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index f8e81e824c3f4..e7a83fe102528 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -390,7 +390,7 @@ static unsigned long damon_pa_migrate(struct damon_region *r,
 				folio_is_file_lru(folio));
 		list_add(&folio->lru, &folio_list);
 put_folio:
-		addr += folio_size(folio);
+		addr = PFN_PHYS(folio_pfn(folio)) + folio_size(folio);
 		folio_put(folio);
 	}
 	applied = damon_migrate_pages(&folio_list, s->target_nid);
-- 
2.47.3

