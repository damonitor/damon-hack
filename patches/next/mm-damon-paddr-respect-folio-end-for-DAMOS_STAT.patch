From: SJ Park <sj@kernel.org>
Date: Thu, 23 Jul 2026 07:51:31 -0700
Subject: [PATCH] mm/damon/paddr: respect folio end for DAMOS_STAT

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index 88687e4d80725..0b19be04dc636 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -484,7 +484,7 @@ static unsigned long damon_pa_stat(struct damon_region *r,
 
 		if (!damos_pa_filter_out(s, folio))
 			*sz_filter_passed += folio_size(folio) / addr_unit;
-		addr += folio_size(folio);
+		addr = PFN_PHYS(folio_pfn(folio)) + folio_size(folio);
 		folio_put(folio);
 	}
 	s->last_applied = folio;
-- 
2.47.3

