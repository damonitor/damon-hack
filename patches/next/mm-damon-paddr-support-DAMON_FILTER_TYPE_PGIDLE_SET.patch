From: SJ Park <sj@kernel.org>
Date: Sat, 5 Sep 2026 13:36:53 -0700
Subject: [PATCH] mm/damon/paddr: support DAMON_FILTER_TYPE_PGIDLE_SET

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index 5ac965fa5f640..6260c2abaf69a 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -216,6 +216,11 @@ static bool damon_pa_filter_match(struct damon_filter *filter,
 		else
 			matched = damon_folio_young(folio);
 		break;
+	case DAMON_FILTER_TYPE_PGIDLE_SET:
+		if (!folio)
+			matched = false;
+		else
+			matched = damon_folio_young(folio) == false;
 	default:
 		return damon_ops_filter_match(filter, folio);
 	}
-- 
2.47.3

