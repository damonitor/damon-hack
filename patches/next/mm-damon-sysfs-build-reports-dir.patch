From: SJ Park <sj@kernel.org>
Date: Wed, 11 Nov 2026 15:43:44 -0800
Subject: [PATCH] mm/damon/sysfs: build reports dir

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 42 ++++++++++++++++++++++++++++--------------
 1 file changed, 28 insertions(+), 14 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index fe58c03e5e0a6..8c28b7065cdc4 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -3176,7 +3176,7 @@ ATTRIBUTE_GROUPS(damon_sysfs_producer);
 static const struct kobj_type damon_sysfs_producer_ktype = {
 	.release = damon_sysfs_producer_release,
 	.sysfs_ops = &kobj_sysfs_ops,
-	.default_groups = damon_sysfs_producers_groups,
+	.default_groups = damon_sysfs_producer_groups,
 };
 
 /* producers dir */
@@ -3332,14 +3332,6 @@ static int damon_sysfs_reports_add_dirs(struct damon_sysfs_reports *reports)
 	return err;
 }
 
-static void damon_sysfs_reports_rm_dirs(struct damon_sysfs_reports *reports)
-{
-	if (reports->producers) {
-		damon_sysfs_producers_rm_dirs(reports->producers);
-		kobject_put(&reports->producers->kobj);
-	}
-}
-
 static void damon_sysfs_reports_release(struct kobject *kobj)
 {
 	kfree(container_of(kobj, struct damon_sysfs_reports, kobj));
@@ -3356,7 +3348,6 @@ static const struct kobj_type damon_sysfs_reports_ktype = {
 	.default_groups = damon_sysfs_reports_groups,
 };
 
-
 /*
  * damon user interface directory
  */
@@ -3364,6 +3355,7 @@ static const struct kobj_type damon_sysfs_reports_ktype = {
 struct damon_sysfs_ui_dir {
 	struct kobject kobj;
 	struct damon_sysfs_kdamonds *kdamonds;
+	struct damon_sysfs_reports *reports;
 };
 
 static struct damon_sysfs_ui_dir *damon_sysfs_ui_dir_alloc(void)
@@ -3374,6 +3366,7 @@ static struct damon_sysfs_ui_dir *damon_sysfs_ui_dir_alloc(void)
 static int damon_sysfs_ui_dir_add_dirs(struct damon_sysfs_ui_dir *ui_dir)
 {
 	struct damon_sysfs_kdamonds *kdamonds;
+	struct damon_sysfs_reports *reports;
 	int err;
 
 	kdamonds = damon_sysfs_kdamonds_alloc();
@@ -3383,11 +3376,32 @@ static int damon_sysfs_ui_dir_add_dirs(struct damon_sysfs_ui_dir *ui_dir)
 	err = kobject_init_and_add(&kdamonds->kobj,
 			&damon_sysfs_kdamonds_ktype, &ui_dir->kobj,
 			"kdamonds");
-	if (err) {
-		kobject_put(&kdamonds->kobj);
-		return err;
-	}
+	if (err)
+		goto put_kdamonds_out;
 	ui_dir->kdamonds = kdamonds;
+
+	reports = damon_sysfs_reports_alloc();
+	if (!reports) {
+		err = -ENOMEM;
+		goto put_kdamonds_out;
+	}
+	ui_dir->reports = reports;
+
+	err = kobject_init_and_add(&reports->kobj, &damon_sysfs_reports_ktype,
+			&ui_dir->kobj, "reports");
+	if (err)
+		goto put_reports_out;
+	err = damon_sysfs_reports_add_dirs(reports);
+	if (err)
+		goto put_reports_out;
+	return err;
+
+put_reports_out:
+	kobject_put(&reports->kobj);
+	ui_dir->reports = NULL;
+put_kdamonds_out:
+	kobject_put(&kdamonds->kobj);
+	ui_dir->kdamonds = NULL;
 	return err;
 }
 
-- 
2.47.3

