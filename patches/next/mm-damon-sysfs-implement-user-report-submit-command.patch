From: SJ Park <sj@kernel.org>
Date: Wed, 11 Nov 2026 16:29:51 -0800
Subject: [PATCH] mm/damon/sysfs: implement user report submit command

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index b292c4737376f..b49ddd81fe285 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -3170,13 +3170,26 @@ static ssize_t producer_state_store(struct kobject *kobj,
 {
         struct damon_sysfs_producer *producer = container_of(kobj,
                         struct damon_sysfs_producer, kobj);
+	struct damon_report report;
+	int err;
 
-	if (sysfs_streq(buf, "on"))
+	if (sysfs_streq(buf, "on")) {
 		producer->enabled = true;
-	else if (sysfs_streq(buf, "off"))
+	} else if (sysfs_streq(buf, "off")) {
 		producer->enabled = false;
-	else
+	} else if (sysfs_streq(buf, "submit")) {
+		if (!producer->enabled)
+			return -EINVAL;
+		if (producer->report_type != DAMON_REPORT_TYPE_USER_REPORT)
+			return -EINVAL;
+		report.type = DAMON_REPORT_TYPE_USER_REPORT;
+		report.addr_range = producer->addr_range;
+		err = damon_submit_report(&report);
+		if (err)
+			return err;
+	} else {
 		return -EINVAL;
+	}
 	return count;
 }
 
