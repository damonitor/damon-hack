From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 15:51:17 -0800
Subject: [PATCH] mm/damon/sysfs: remove wrong filter argument setup

fixup 690085867ed6

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index b49ddd81fe285..274175bd7722c 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2400,8 +2400,6 @@ static int damon_sysfs_set_filters(struct damon_probe *probe,
 			filter->range_max = sys_filter->range_max;
 		} else if (filter->type == DAMON_FILTER_TYPE_REPORT) {
 			filter->report_type = sys_filter->report_type;
-			filter->report_addr_start = sys_filter->range_min;
-			filter->report_addr_end = sys_filter->range_max;
 		}
 		damon_add_filter(probe, filter);
 	}
-- 
2.47.3

