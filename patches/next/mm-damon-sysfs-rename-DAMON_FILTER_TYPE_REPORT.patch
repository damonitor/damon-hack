From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 15:57:13 -0800
Subject: [PATCH] mm/damon/sysfs: rename DAMON_FILTER_TYPE_REPORT

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index 274175bd7722c..f5a7c83eb5683 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -1017,8 +1017,8 @@ damon_sysfs_filter_type_names[] = {
 		.name = "active",
 	},
 	{
-		.type = DAMON_FILTER_TYPE_REPORT,
-		.name = "report",
+		.type = DAMON_FILTER_TYPE_REPORT_MADE,
+		.name = "report_made",
 	},
 };
 
@@ -2398,7 +2398,7 @@ static int damon_sysfs_set_filters(struct damon_probe *probe,
 		} else if (filter->type == DAMON_FILTER_TYPE_HUGEPAGE_SIZE) {
 			filter->range_min = sys_filter->range_min;
 			filter->range_max = sys_filter->range_max;
-		} else if (filter->type == DAMON_FILTER_TYPE_REPORT) {
+		} else if (filter->type == DAMON_FILTER_TYPE_REPORT_MADE) {
 			filter->report_type = sys_filter->report_type;
 		}
 		damon_add_filter(probe, filter);
-- 
2.47.3

