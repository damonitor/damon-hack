From: SJ Park <sj@kernel.org>
Date: Tue, 24 Nov 2026 21:07:52 -0800
Subject: [PATCH] mm/damon/sysfs: use damon_sysfs_cmd_names in state_show()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index bd3ea2200655b..1d6534bc80903 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2317,6 +2317,8 @@ static ssize_t state_show(struct kobject *kobj, struct kobj_attribute *attr,
 			struct damon_sysfs_kdamond, kobj);
 	struct damon_ctx *ctx;
 	bool running = false;
+	enum damon_sysfs_cmd cmd;
+	int i;
 
 	if (!mutex_trylock(&damon_sysfs_lock))
 		return -EBUSY;
@@ -2327,7 +2329,15 @@ static ssize_t state_show(struct kobject *kobj, struct kobj_attribute *attr,
 
 	mutex_unlock(&damon_sysfs_lock);
 
-	return sysfs_emit(buf, "%s\n", running ? "on" : "off");
+	cmd = running ? DAMON_SYSFS_CMD_ON : DAMON_SYSFS_CMD_OFF;
+	for (i = 0; i < ARRAY_SIZE(damon_sysfs_cmd_names); i++) {
+		const struct damon_sysfs_cmd_name *cmd_name;
+
+		cmd_name = &damon_sysfs_cmd_names[i];
+		if (cmd_name->cmd == cmd)
+			return sysfs_emit(buf, "%s\n", cmd_name->name);
+	}
+	return -EINVAL;
 }
 
 static int damon_sysfs_set_attrs(struct damon_ctx *ctx,
-- 
2.47.3

