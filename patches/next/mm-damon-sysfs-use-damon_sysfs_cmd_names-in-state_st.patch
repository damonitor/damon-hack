From: SJ Park <sj@kernel.org>
Date: Sun, 8 Nov 2026 14:42:28 -0800
Subject: [PATCH] mm/damon/sysfs: use damon_sysfs_cmd_names in state_store()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index 163f98c313f8f..5a8dd5c54f799 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2812,14 +2812,17 @@ static ssize_t state_store(struct kobject *kobj, struct kobj_attribute *attr,
 {
 	struct damon_sysfs_kdamond *kdamond = container_of(kobj,
 			struct damon_sysfs_kdamond, kobj);
-	enum damon_sysfs_cmd cmd;
 	ssize_t ret = -EINVAL;
+	int i;
 
 	if (!mutex_trylock(&damon_sysfs_lock))
 		return -EBUSY;
-	for (cmd = 0; cmd < NR_DAMON_SYSFS_CMDS; cmd++) {
-		if (sysfs_streq(buf, damon_sysfs_cmd_strs[cmd])) {
-			ret = damon_sysfs_handle_cmd(cmd, kdamond);
+	for (i = 0; i < ARRAY_SIZE(damon_sysfs_cmd_names); i++) {
+		const struct damon_sysfs_cmd_name *cmd_name;
+
+		cmd_name = &damon_sysfs_cmd_names[i];
+		if (sysfs_streq(buf, cmd_name->name)) {
+			ret = damon_sysfs_handle_cmd(cmd_name->cmd, kdamond);
 			break;
 		}
 	}
-- 
2.47.3

