From: SJ Park <sj@kernel.org>
Date: Sun, 8 Nov 2026 14:44:17 -0800
Subject: [PATCH] mm/damon/sysfs: use on/off literals in state_show()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index 5a8dd5c54f799..e48e218081b55 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2281,9 +2281,7 @@ static ssize_t state_show(struct kobject *kobj, struct kobj_attribute *attr,
 
 	mutex_unlock(&damon_sysfs_lock);
 
-	return sysfs_emit(buf, "%s\n", running ?
-			damon_sysfs_cmd_strs[DAMON_SYSFS_CMD_ON] :
-			damon_sysfs_cmd_strs[DAMON_SYSFS_CMD_OFF]);
+	return sysfs_emit(buf, "%s\n", running ? "on" : "off");
 }
 
 static int damon_sysfs_set_attrs(struct damon_ctx *ctx,
-- 
2.47.3

