From: SJ Park <sj@kernel.org>
Date: Sun, 1 Nov 2026 09:36:15 -0800
Subject: [PATCH] mm/damon/vaddr: set page_idx and nr before last_applied check

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/vaddr.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/mm/damon/vaddr.c b/mm/damon/vaddr.c
index d753ce6c1abd9..ddfad925301dd 100644
--- a/mm/damon/vaddr.c
+++ b/mm/damon/vaddr.c
@@ -891,10 +891,10 @@ static int damos_va_migrate_pmd_entry(pmd_t *pmd, unsigned long addr,
 		if (pte_none(ptent) || !pte_present(ptent))
 			continue;
 		folio = vm_normal_folio(walk->vma, addr, ptent);
-		if (damos_va_invalid_folio(folio, s))
-			continue;
 		page_idx = folio_page_idx(folio, pte_page(ptent));
 		nr = folio_nr_pages(folio) - page_idx;
+		if (damos_va_invalid_folio(folio, s))
+			continue;
 		s->last_applied = folio;
 		if (damos_va_filter_out(s, folio, walk->vma, addr, pte, NULL))
 			continue;
-- 
2.47.3

