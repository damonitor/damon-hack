From: SJ Park <sj@kernel.org>
Date: Thu, 6 Aug 2026 17:37:58 -0700
Subject: [PATCH] mm/damon/vaddr: support set_samples on
 damon_va_apply_probes()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/vaddr.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/mm/damon/vaddr.c b/mm/damon/vaddr.c
index daf7e32d5e958..c3bc5fc38c223 100644
--- a/mm/damon/vaddr.c
+++ b/mm/damon/vaddr.c
@@ -628,8 +628,12 @@ static unsigned int damon_va_apply_probes(struct damon_ctx *ctx,
 
 	damon_for_each_target(t, ctx) {
 		mm = damon_get_mm(t);
-		damon_for_each_region(r, t)
+		damon_for_each_region(r, t) {
+			if (set_samples)
+				r->sampling_addr = damon_rand(ctx, r->ar.start,
+						r->ar.end);
 			__damon_va_apply_probes(ctx, mm, r);
+		}
 		if (mm)
 			mmput(mm);
 	}
-- 
2.47.3

