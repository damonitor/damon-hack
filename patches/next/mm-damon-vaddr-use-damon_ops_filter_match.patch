From: SJ Park <sj@kernel.org>
Date: Sat, 15 Aug 2026 09:41:50 -0700
Subject: [PATCH] mm/damon/vaddr: use damon_ops_filter_match()

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/vaddr.c | 23 +----------------------
 1 file changed, 1 insertion(+), 22 deletions(-)

diff --git a/mm/damon/vaddr.c b/mm/damon/vaddr.c
index 463b06184e870..090317191973b 100644
--- a/mm/damon/vaddr.c
+++ b/mm/damon/vaddr.c
@@ -568,29 +568,8 @@ static bool damon_va_filter_match(struct damon_filter *filter,
 		struct mm_struct *mm, unsigned long addr)
 {
 	bool matched = false;
-	struct mem_cgroup *memcg;
 
 	switch (filter->type) {
-	case DAMON_FILTER_TYPE_ANON:
-		if (!folio) {
-			matched = false;
-			break;
-		}
-		matched = folio_test_anon(folio);
-		break;
-	case DAMON_FILTER_TYPE_MEMCG:
-		if (!folio) {
-			matched = false;
-			break;
-		}
-		rcu_read_lock();
-		memcg = folio_memcg_check(folio);
-		if (!memcg)
-			matched = false;
-		else
-			matched = filter->memcg_id == mem_cgroup_id(memcg);
-		rcu_read_unlock();
-		break;
 	case DAMON_FILTER_TYPE_PGIDLE_UNSET:
 		if (!folio)
 			matched = false;
@@ -599,7 +578,7 @@ static bool damon_va_filter_match(struct damon_filter *filter,
 					addr);
 		break;
 	default:
-		break;
+		return damon_ops_filter_match(filter, folio);
 	}
 	return matched == filter->matching;
 }
-- 
2.47.3

