From: SJ Park <sj@kernel.org>
Date: Fri, 27 Nov 2026 15:10:41 -0800
Subject: [PATCH] mm/hugetlb: fixup build failure

Apparently the fixup patches are dropped by mistake and causing build
failure.

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/huge_memory.c | 2 +-
 mm/hugetlb.c     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/mm/huge_memory.c b/mm/huge_memory.c
index a89a5d200960..4fc888ddfb69 100644
--- a/mm/huge_memory.c
+++ b/mm/huge_memory.c
@@ -2543,7 +2543,7 @@ static void zap_huge_pmd_folio(struct mmu_gather *tlb, struct vm_area_struct *vm
 	/* Device private folios are pinned and don't need a TLB flush. */
 	if (is_device_private)
 		folio_put(folio);
-	else if (__tlb_remove_page_size(tlb, &folio->page, HPAGE_PMD_SIZE))
+	else if (__tlb_remove_page_size(tlb, &folio->page, HPAGE_PMD_SIZE, false))
 		*force_flush = true;
 
 	if (delay_rmap) {
diff --git a/mm/hugetlb.c b/mm/hugetlb.c
index 15f06a98f7df..4386425b5ce5 100644
--- a/mm/hugetlb.c
+++ b/mm/hugetlb.c
@@ -5452,7 +5452,7 @@ static void hugetlb_unmap_range(struct mmu_gather *tlb,
 		 * entries are gone, unless the mm has no users left.
 		 */
 		if (folio_test_anon(folio) && !tlb->fullmm) {
-			delay_rmap = tlb_delay_rmap(tlb);
+			delay_rmap = tlb_can_delay_rmap();
 			/*
 			 * Without delay-rmap support, just flush before
 			 * dropping the PTL. Except with MMU_GATHER_NO_GATHER
-- 
2.47.3

