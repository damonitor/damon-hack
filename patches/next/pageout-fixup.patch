From: SJ Park <sj@kernel.org>
Date: Sat, 25 Jul 2026 10:52:24 -0700
Subject: [PATCH] pageout fixup

Let's keep the behavior for now...

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index a4989bd81d963..18c88080641e3 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -349,16 +349,11 @@ static unsigned long damon_pa_pageout(struct damon_region *r,
 
 	addr = damon_pa_phys_addr(r->ar.start, addr_unit);
 	while (addr < damon_pa_phys_addr(r->ar.end, addr_unit)) {
-		phys_addr_t folio_addr;
-
 		folio = damon_get_folio(PHYS_PFN(addr));
 		if (damon_pa_invalid_damos_folio(folio, s)) {
 			addr += PAGE_SIZE;
 			continue;
 		}
-		folio_addr = PFN_PHYS(folio_pfn(folio));
-		if (folio_addr < addr)
-			goto put_folio;
 
 		if (damos_pa_filter_out(s, folio))
 			goto put_folio;
@@ -374,7 +369,7 @@ static unsigned long damon_pa_pageout(struct damon_region *r,
 		else
 			list_add(&folio->lru, &folio_list);
 put_folio:
-		addr = folio_addr + folio_size(folio);
+		addr = PFN_PHYS(folio_pfn(folio)) + folio_size(folio);
 		folio_put(folio);
 	}
 	if (install_young_filter)
-- 
2.47.3

