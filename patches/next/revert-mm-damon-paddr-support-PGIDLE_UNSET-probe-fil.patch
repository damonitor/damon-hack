From: SJ Park <sj@kernel.org>
Date: Sat, 25 Jul 2026 11:46:24 -0700
Subject: [PATCH] revert mm/damon/paddr: support PGIDLE_UNSET probe filter type

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index 199de1463fa06..5a6a78054784a 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -132,12 +132,6 @@ static bool damon_pa_filter_match(struct damon_filter *filter,
 			matched = filter->memcg_id == mem_cgroup_id(memcg);
 		rcu_read_unlock();
 		break;
-	case DAMON_FILTER_TYPE_PGIDLE_UNSET:
-		if (!folio)
-			matched = false;
-		else
-			matched = damon_folio_young(folio);
-		break;
 	default:
 		break;
 	}
-- 
2.47.3

