From: SJ Park <sj@kernel.org>
Date: Sat, 25 Jul 2026 11:34:12 -0700
Subject: [PATCH] revert mm/damon/paddr: support preps

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/paddr.c | 35 -----------------------------------
 1 file changed, 35 deletions(-)

diff --git a/mm/damon/paddr.c b/mm/damon/paddr.c
index 8d8fcd1369e56..199de1463fa06 100644
--- a/mm/damon/paddr.c
+++ b/mm/damon/paddr.c
@@ -105,40 +105,6 @@ static unsigned int damon_pa_check_accesses(struct damon_ctx *ctx)
 	return max_nr_accesses;
 }
 
-static void damon_pa_prep_probes_region(struct damon_region *r,
-		struct damon_probe *probe, struct damon_ctx *ctx)
-{
-	struct damon_prep *p;
-
-	damon_for_each_prep(p, probe) {
-		switch (p->action) {
-		case DAMON_PREP_SET_PGIDLE:
-			damon_pa_mkold(damon_pa_phys_addr(r->sampling_addr,
-						ctx->addr_unit));
-			break;
-		default:
-			break;
-		}
-	}
-}
-
-static void damon_pa_prep_probes(struct damon_ctx *ctx, bool set_samples)
-{
-	struct damon_target *t;
-	struct damon_region *r;
-	struct damon_probe *p;
-
-	damon_for_each_target(t, ctx) {
-		damon_for_each_region(r, t) {
-			if (set_samples)
-				r->sampling_addr = damon_rand(ctx, r->ar.start,
-						r->ar.end);
-			damon_for_each_probe(p, ctx)
-				damon_pa_prep_probes_region(r, p, ctx);
-		}
-	}
-}
-
 static bool damon_pa_filter_match(struct damon_filter *filter,
 		struct folio *folio)
 {
@@ -480,7 +446,6 @@ static int __init damon_pa_initcall(void)
 		.update = NULL,
 		.prepare_access_checks = damon_pa_prepare_access_checks,
 		.check_accesses = damon_pa_check_accesses,
-		.prep_probes = damon_pa_prep_probes,
 		.apply_probes = damon_pa_apply_probes,
 		.target_valid = NULL,
 		.apply_scheme = damon_pa_apply_scheme,
-- 
2.47.3

