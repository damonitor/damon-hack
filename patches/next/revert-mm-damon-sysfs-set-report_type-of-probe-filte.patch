From: SJ Park <sj@kernel.org>
Date: Sat, 14 Nov 2026 13:12:46 -0800
Subject: [PATCH] revert mm/damon/sysfs: set report_type of probe filter

Signed-off-by: SJ Park <sj@kernel.org>
---
 mm/damon/sysfs.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/mm/damon/sysfs.c b/mm/damon/sysfs.c
index 055efac931a21..fb8f758387ab4 100644
--- a/mm/damon/sysfs.c
+++ b/mm/damon/sysfs.c
@@ -2340,8 +2340,6 @@ static int damon_sysfs_set_filters(struct damon_probe *probe,
 		} else if (filter->type == DAMON_FILTER_TYPE_HUGEPAGE_SIZE) {
 			filter->range_min = sys_filter->range_min;
 			filter->range_max = sys_filter->range_max;
-		} else if (filter->type == DAMON_FILTER_TYPE_REPORT) {
-			filter->report_type = sys_filter->report_type;
 		}
 		damon_add_filter(probe, filter);
 	}
-- 
2.47.3

