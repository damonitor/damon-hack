From: SJ Park <sj@kernel.org>
Date: Wed, 29 Jul 2026 17:06:31 -0700
Subject: [PATCH] selftests/damon/_damon_sysfs: handle err from Probe.stage()

Signed-off-by: SJ Park <sj@kernel.org>
---
 tools/testing/selftests/damon/_damon_sysfs.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tools/testing/selftests/damon/_damon_sysfs.py b/tools/testing/selftests/damon/_damon_sysfs.py
index d6afb5b2f0a4a..94bf0aaae9f59 100644
--- a/tools/testing/selftests/damon/_damon_sysfs.py
+++ b/tools/testing/selftests/damon/_damon_sysfs.py
@@ -639,6 +639,8 @@ class DamonProbe:
     def stage(self):
         err = write_file(
                 os.path.join(self.sysfs_dir(), 'weight'), '%d' % self.weight)
+        if err is not None:
+            return err
         return self.filters.stage()
 
 class DamonProbes:
